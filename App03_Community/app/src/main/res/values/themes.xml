<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.App03_Community" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <!-- 모든 UI 요소의 기본 색상 -->
        <item name="colorPrimary">@color/material_dynamic_primary40</item>
        <!-- 상단 상태바 색상 -->
        <item name="colorPrimaryDark">@color/material_dynamic_tertiary99</item>
        <!-- 상태바에 나타나는 저옵 테마를 지정한다.-->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.App03_Community" parent="Base.Theme.App03_Community" />

    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
<!--        <item name="windowSplashScreenBackground">@color/white</item>-->
<!--        <item name="windowSplashScreenAnimatedIcon">@mipmap/logo_icon</item>-->
<!--        <item name="windowSplashScreenAnimationDuration">1000</item>-->
<!--        <item name="postSplashScreenTheme">@style/Theme.App03_Community</item>-->

        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/test_screen</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.App03_Community</item>
    </style>

    <style name="Theme.App03_Community.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorPrimary">@color/material_dynamic_tertiary99</item>
    </style>
</resources>