<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 실제 앱 테마 -->
    <style name="Theme.App2LBS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 스플래시 전용 테마 -->
    <style name="Theme.App2LBS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/logo_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.App2LBS</item>
    </style>

</resources>